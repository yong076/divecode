#!/usr/bin/env bash
# divecode-bolt-new — create or resume a bolt for a project.
#
# Usage:
#   divecode-bolt-new --profile <kind> --size <S|M|L> [--project <path>]
#
# Bolt id format: YYYYMMDD-HHMMSS-<6char-path-hash>
# State directory: $DIVECODE_STATE_DIR (default: ~/.divecode/state)

set -uo pipefail

PROFILE=""
SIZE=""
PROJ_PATH="$PWD"

while [ $# -gt 0 ]; do
  case "$1" in
    --profile) PROFILE="$2"; shift 2 ;;
    --size)    SIZE="$2"; shift 2 ;;
    --project) PROJ_PATH="$2"; shift 2 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

[ -z "$PROFILE" ] && { echo "missing --profile" >&2; exit 2; }
[ -z "$SIZE" ] && { echo "missing --size" >&2; exit 2; }

STATE_DIR="${DIVECODE_STATE_DIR:-$HOME/.divecode/state}"
BOLTS_DIR="$STATE_DIR/bolts"
mkdir -p "$BOLTS_DIR"

PROJ_ABS=$(cd "$PROJ_PATH" 2>/dev/null && pwd || echo "$PROJ_PATH")

# Check for existing active bolt for this project
for existing in "$BOLTS_DIR"/*/bolt.yml; do
  [ -f "$existing" ] || continue
  existing_proj=$(grep -E '^project_path:' "$existing" | head -1 | awk '{print $2}')
  existing_status=$(grep -E '^status:' "$existing" | head -1 | awk '{print $2}')
  if [ "$existing_proj" = "$PROJ_ABS" ] && [ "$existing_status" = "active" ]; then
    bid=$(basename "$(dirname "$existing")")
    echo "bolt: $bid (resumed)"
    exit 0
  fi
done

# Mint new id
HASH=$(printf '%s' "$PROJ_ABS" | shasum 2>/dev/null | head -c 6 || printf '%s' "$PROJ_ABS" | md5 | head -c 6)
TS=$(date -u +%Y%m%d-%H%M%S)
BOLT_ID="$TS-$HASH"

mkdir -p "$BOLTS_DIR/$BOLT_ID"
cat > "$BOLTS_DIR/$BOLT_ID/bolt.yml" <<EOF
kind: $PROFILE
size: $SIZE
project_path: $PROJ_ABS
created_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
status: active
EOF

echo "bolt: $BOLT_ID"
echo "dir:  $BOLTS_DIR/$BOLT_ID"
