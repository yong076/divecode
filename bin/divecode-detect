#!/usr/bin/env bash
# divecode-detect — recommend a profile based on project signals.
#
# Signals (0-3 points each):
#   1. multi-contributor (>1 unique author in last 30 commits)   +2
#   2. tests directory (tests/, test/, spec/, __tests__/)         +1
#   3. CI config (GitHub Actions / GitLab CI / CircleCI / Azure)  +2
#   4. architecture doc (ARCHITECTURE.md / DESIGN.md / docs/)     +2
#   5. CONTRIBUTING.md                                            +1
#   6. substantial README (> 1000 bytes)                          +1
#
# Mapping:
#   0-2  → light
#   3-6  → standard
#   7-9  → strict
#
# Usage:
#   divecode-detect            # print recommendation only
#   divecode-detect --confirm  # also write .divecode/profile.yml

set -uo pipefail

PROJ="${DIVECODE_PROJECT_DIR:-$PWD}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIVECODE_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"
TEMPLATE="$DIVECODE_HOME/templates/profile.yml.template"

CONFIRM=0
for a in "$@"; do
  case "$a" in
    --confirm) CONFIRM=1 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0"
      exit 0
      ;;
  esac
done

# Short-circuit: profile already set
if [ -f "$PROJ/.divecode/profile.yml" ]; then
  echo "already configured: $PROJ/.divecode/profile.yml"
  cat "$PROJ/.divecode/profile.yml"
  exit 0
fi

score=0
signals=()

# 1. multi-contributor
if [ -d "$PROJ/.git" ]; then
  authors=$(git -C "$PROJ" log -n 30 --format='%ae' 2>/dev/null | sort -u | wc -l | tr -d ' ')
  if [ "${authors:-0}" -gt 1 ]; then
    score=$((score+2)); signals+=("multi-contributor(+2)")
  fi
fi

# 2. tests directory
for d in tests test spec __tests__; do
  if [ -d "$PROJ/$d" ]; then
    score=$((score+1)); signals+=("tests-dir(+1)"); break
  fi
done

# 3. CI config
ci=0
[ -d "$PROJ/.github/workflows" ] && ci=1
[ -f "$PROJ/.gitlab-ci.yml" ] && ci=1
[ -d "$PROJ/.circleci" ] && ci=1
[ -f "$PROJ/azure-pipelines.yml" ] && ci=1
if [ "$ci" -eq 1 ]; then
  score=$((score+2)); signals+=("ci-config(+2)")
fi

# 4. architecture doc
arch=0
[ -f "$PROJ/ARCHITECTURE.md" ] && arch=1
[ -f "$PROJ/DESIGN.md" ] && arch=1
[ -f "$PROJ/docs/architecture.md" ] && arch=1
if [ "$arch" -eq 1 ]; then
  score=$((score+2)); signals+=("arch-doc(+2)")
fi

# 5. CONTRIBUTING
if [ -f "$PROJ/CONTRIBUTING.md" ]; then
  score=$((score+1)); signals+=("contributing(+1)")
fi

# 6. substantial README
if [ -f "$PROJ/README.md" ]; then
  size=$(wc -c < "$PROJ/README.md" | tr -d ' ')
  if [ "${size:-0}" -gt 1000 ]; then
    score=$((score+1)); signals+=("substantial-readme(+1)")
  fi
fi

# Map score to profile
if [ "$score" -le 2 ]; then
  profile="light"
elif [ "$score" -le 6 ]; then
  profile="standard"
else
  profile="strict"
fi

# Gate mapping per profile
case "$profile" in
  light)    tdd_gate="off";    repo_pattern="off" ;;
  standard) tdd_gate="warn";   repo_pattern="warn" ;;
  strict)   tdd_gate="refuse"; repo_pattern="must-fix" ;;
esac

echo "score: $score"
echo "signals: ${signals[*]:-none}"
echo "recommendation: $profile"

if [ "$CONFIRM" -eq 1 ]; then
  mkdir -p "$PROJ/.divecode"
  if [ -f "$TEMPLATE" ]; then
    sed -e "s/__KIND__/$profile/g" \
        -e "s/__TDD__/$tdd_gate/g" \
        -e "s/__REPO_PATTERN__/$repo_pattern/g" \
        -e "s/__GENERATED_AT__/$(date -u +%Y-%m-%dT%H:%M:%SZ)/" \
        "$TEMPLATE" > "$PROJ/.divecode/profile.yml"
  else
    cat > "$PROJ/.divecode/profile.yml" <<EOF
# Generated by divecode-detect (inline fallback)
kind: $profile
gates:
  tdd: $tdd_gate
  repository_pattern: $repo_pattern
EOF
  fi
  echo "wrote: $PROJ/.divecode/profile.yml"
fi
