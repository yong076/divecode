#!/usr/bin/env bash
# divecode-lore-cite — cascade-read user + project lore, rank by relevance,
# emit a "Relevant lore" envelope block suitable for prompt injection.
#
# Usage:
#   divecode-lore-cite "<query keywords>" [--project <path>]
#
# Cascade order:
#   1. user-global:    $HOME/.divecode/lore/
#   2. project-local:  <project>/.divecode/lore/
#
# Duplicate names (same filename): project-local wins.
# Relevance: substring match of any query word against entry name or body
# (case-insensitive). Unmatched entries are filtered out.

set -uo pipefail

QUERY="${1:-}"
shift || true
PROJ_PATH="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --project) PROJ_PATH="$2"; shift 2 ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) shift ;;
  esac
done

USER_LORE="$HOME/.divecode/lore"
PROJ_LORE="$PROJ_PATH/.divecode/lore"

# Gather candidate entries: project-local first so it wins on dedup
declare -a NAMES_SEEN=()
declare -a OUTPUT=()

include_entry() {
  local name="$1" path="$2"
  for seen in "${NAMES_SEEN[@]:-}"; do
    [ "$seen" = "$name" ] && return 1
  done
  NAMES_SEEN+=("$name")
  return 0
}

matches_query() {
  local path="$1" q="$2"
  [ -z "$q" ] && return 0
  local body name
  body=$(cat "$path" 2>/dev/null)
  name=$(basename "$path" .md)
  # any whitespace-separated word in q present in name or body (case-insensitive)
  local hit=0
  for w in $q; do
    [ -z "$w" ] && continue
    if printf '%s\n%s' "$name" "$body" | LC_ALL=C grep -iq -- "$w"; then
      hit=1; break
    fi
  done
  [ "$hit" -eq 1 ]
}

scan_dir() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  for f in "$dir"/*.md; do
    [ -f "$f" ] || continue
    local name
    name=$(basename "$f" .md)
    if include_entry "$name" "$f"; then
      if matches_query "$f" "$QUERY"; then
        OUTPUT+=("$f")
      fi
    fi
  done
}

# Project first → wins dedup
scan_dir "$PROJ_LORE"
scan_dir "$USER_LORE"

if [ "${#OUTPUT[@]}" -eq 0 ]; then
  echo "no lore matched for query: $QUERY"
  exit 0
fi

# Emit envelope
cat <<EOF
<!-- Relevant lore (auto-cited by divecode-lore-cite) -->
## Relevant lore

EOF

for f in "${OUTPUT[@]}"; do
  rel=$(echo "$f" | sed "s|^$HOME/|~/|" | sed "s|^$PROJ_PATH/|./|")
  echo "### $(basename "$f" .md) — $rel"
  cat "$f"
  echo ""
done
