#!/usr/bin/env bash
# divecode-prd-triggers — scan a PRD against all packs' triggers; output
# matched packs with which triggers fired.
#
# Usage:
#   divecode-prd-triggers --prd <prd-file> [--packs-dir <dir>]
#
# Output (plain text, sectioned per matched pack):
#   pack: <name>
#   title: <title>
#   matched: trig1, trig2, ...
#   <blank>
#
# Or "no packs matched" if nothing fires.

set -uo pipefail

PRD=""
PACKS_DIR="${DIVECODE_HOME:-}/packs"
[ -d "$PACKS_DIR" ] || PACKS_DIR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prd) PRD="$2"; shift 2 ;;
    --packs-dir) PACKS_DIR="$2"; shift 2 ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

[ -n "$PRD" ] || { echo "missing --prd" >&2; exit 2; }
[ -f "$PRD" ] || { echo "PRD not found: $PRD" >&2; exit 1; }
[ -n "$PACKS_DIR" ] && [ -d "$PACKS_DIR" ] || { echo "packs dir not found: $PACKS_DIR" >&2; exit 1; }

# Match a single trigger against the PRD with appropriate strictness:
#   - multi-word trigger: literal case-insensitive substring
#   - single-word trigger: word-boundary match (won't hit 'ttl' inside 'throttle')
match_trigger() {
  local prd_path="$1" trig="$2"
  if [[ "$trig" == *" "* ]]; then
    LC_ALL=C grep -iqF -- "$trig" "$prd_path"
  else
    LC_ALL=C grep -Eiq -- "(^|[^a-zA-Z0-9])$trig([^a-zA-Z0-9]|$)" "$prd_path"
  fi
}

read_yml_field() {
  grep -E "^$2:" "$1" | head -1 | sed -E "s/^$2:[[:space:]]*//"
}

any_matched=0
output=""

for pack_dir in "$PACKS_DIR"/*/; do
  [ -d "$pack_dir" ] || continue
  yml="$pack_dir/pack.yml"
  [ -f "$yml" ] || continue
  name=$(read_yml_field "$yml" name)
  title=$(read_yml_field "$yml" title)
  triggers_raw=$(read_yml_field "$yml" triggers)
  [ -n "$triggers_raw" ] || continue

  matched=()
  IFS=',' read -ra TRIGS <<< "$triggers_raw"
  for raw in "${TRIGS[@]}"; do
    trig=$(printf '%s' "$raw" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
    [ -n "$trig" ] || continue
    if match_trigger "$PRD" "$trig"; then
      matched+=("$trig")
    fi
  done

  if [ "${#matched[@]}" -gt 0 ]; then
    any_matched=1
    output+="pack: $name"$'\n'
    output+="title: $title"$'\n'
    output+="matched: $(IFS=,; echo "${matched[*]}" | sed 's/,/, /g')"$'\n'
    output+=$'\n'
  fi
done

if [ "$any_matched" -eq 0 ]; then
  echo "no packs matched"
  exit 0
fi

printf '%s' "$output"
