#!/usr/bin/env bash
# divecode-repo-pattern-check — heuristic check for Google Repository Pattern
# in data-layer code. v0.2 stub: surfaces obvious violations, doesn't try to be
# a full linter.
#
# Usage:
#   divecode-repo-pattern-check [--project <path>] [--level warn|must-fix]
#
# Heuristics:
#   - Find files matching *Repository* or *Repo* in the project
#   - For each, check if a sibling *RepositoryImpl* or *RepoImpl* exists
#   - Warn if DTO/Dto types appear OUTSIDE files in path components matching 'data'
#
# Output: list of issues. Exit 0 if none. Exit 1 if --level must-fix and issues exist.

set -uo pipefail

PROJ="$PWD"
LEVEL="warn"
while [ $# -gt 0 ]; do
  case "$1" in
    --project) PROJ="$2"; shift 2 ;;
    --level)   LEVEL="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) shift ;;
  esac
done

issues=()

# 1. Repository interfaces without Impls
while IFS= read -r f; do
  bn=$(basename "$f")
  # Skip Impls themselves
  case "$bn" in *Impl*) continue ;; esac
  stem="${bn%.*}"
  # Look for any *Impl* file referencing this stem
  if ! grep -RIl --include='*' "$stem" "$PROJ" 2>/dev/null | grep -q "Impl"; then
    issues+=("$f: declares ${stem} but no *Impl* implementer found")
  fi
done < <(find "$PROJ" -type f \( -name '*Repository*' -o -name '*Repo*' \) 2>/dev/null \
          -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/archive/*' \
          -not -path '*/tests/*' -not -path '*/test/*')

# 2. DTOs outside data layer
while IFS= read -r f; do
  if [[ "$f" != */data/* ]] && [[ "$f" != */Data/* ]]; then
    issues+=("$f: DTO type appears outside data/ layer")
  fi
done < <(grep -RIl --include='*.swift' --include='*.kt' --include='*.ts' --include='*.py' \
              -E '(class|struct|data class|interface)[[:space:]]+[A-Z][A-Za-z0-9]*(Dto|DTO)\b' "$PROJ" 2>/dev/null \
          | grep -v '/archive/' | grep -v '/tests/')

if [ "${#issues[@]}" -eq 0 ]; then
  echo "repo-pattern: OK (no obvious violations)"
  exit 0
fi

echo "repo-pattern: ${#issues[@]} issue(s) found"
for i in "${issues[@]}"; do echo "  - $i"; done

if [ "$LEVEL" = "must-fix" ]; then
  exit 1
fi
exit 0
