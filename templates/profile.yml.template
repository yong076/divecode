# .divecode/profile.yml — divecode v0.2
# Generated by divecode-detect on __GENERATED_AT__.
# Hand-edit any field to override the detected defaults.

kind: __KIND__   # light | standard | strict

branching:
  worktree: optional         # required | optional | never
  naming:
    prefix: "feature/"
    slug_style: kebab        # kebab | snake
    slug_source: title       # title | description
    max_slug_length: 50

commit_convention:
  style: conventional        # conventional | freeform
  co_author: omit            # include | omit

pr:
  target_branch: main
  merge_strategy: squash     # squash | rebase | merge

review_angles: []            # extra reviewer angles beyond the mandatory architecture-design

gates:
  tdd: __TDD__                       # off | warn | refuse
  repository_pattern: __REPO_PATTERN__  # off | warn | must-fix

# divecode-original cross-cutting toggles
ux:
  always_ask: true            # the canonical "UI 있어?" prompt; set false to skip after first answer
  remembered_answer: null     # populated after first run (yes | no)

status:
  threshold_percent: 70       # background usage observer interjects at this %
